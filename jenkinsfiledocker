
pipeline {
    agent any

    tools {
        maven 'maven_3.9.9'
    }

    stages {
        stage('git checkout') {
            steps {
                git branch: 'devops-feature-branch',
                    url: 'https://github.com/bolkarnikita/maven-web-application.git'
            }
        }

        stage('build project') {
            steps {
                sh 'mvn clean package'
            }
        }
    }
}



