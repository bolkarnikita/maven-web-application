pipeline
{
    agent any

    tools
    {
        maven 'Maven_3.9.9'
    }

    stages
    {
        stage('Clone Git Repository')
        {
            steps()
            {
                git branch: 'DevOpsSeptemberBatch', url: 'https://github.com/MithunTechnologiesDevOps/maven-web-application.git'
            }
        }

        stage('Build Artifact Using Maven')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }
    }
}